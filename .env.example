# Database (dev/test — ignorado em produção, que usa DATABASE_URL)
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Rails
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=
JWT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173

# Domínio público real da API em produção (com esquema, ex:
# https://api.seu-dominio.com). Usado para montar URLs absolutas (ex:
# media_url dos testimonials via ActiveStorage) — NUNCA derivado da request,
# que dentro do container aponta para "localhost" em chamadas internas
# (health check, curl local) e quebraria a mídia no navegador do cliente.
# Só tem efeito em produção (config/environments/production.rb); se não
# setada, cai no fallback hardcoded pro host padrão do Easypanel.
APP_HOST=

# Active Record encryption (ChannelCredential#credentials) — gerar com `bin/rails db:encryption:init`
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Anthropic API (Testimonials::AnthropicVisionClient — gera quote_text a partir
# de foto/frame de vídeo de um depoimento). Chave de app (não é credencial por
# tenant, ao contrário de ChannelCredential) — sem isso, GenerateQuoteTextJob
# falha e o depoimento fica sem quote_text sugerido (curador preenche à mão).
ANTHROPIC_API_KEY=

# ─── Produção (Easypanel) ────────────────────────────────────────────────
# Fornecidas pelos serviços gerenciados de Postgres/Redis do Easypanel.
DATABASE_URL=
REDIS_URL=

# config/master.key está no .dockerignore e portanto NÃO vai para a imagem —
# forneça RAILS_MASTER_KEY (conteúdo de config/master.key) como env var no
# Easypanel para decriptar config/credentials.yml.enc. Alternativa: setar
# SECRET_KEY_BASE diretamente (tem precedência e evita depender do master key).
RAILS_MASTER_KEY=

RAILS_LOG_TO_STDOUT=true

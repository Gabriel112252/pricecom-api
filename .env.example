# Database (dev/test — ignorado em produção, que usa DATABASE_URL)
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5433

# Rails
RAILS_MAX_THREADS=5
SECRET_KEY_BASE=
JWT_SECRET=

# Frontend
FRONTEND_URL=http://localhost:5173

# Domínio público real da API em produção (com esquema, ex:
# https://api.seu-dominio.com). Usado para montar URLs absolutas (ex:
# media_url dos testimonials via ActiveStorage) — NUNCA derivado da request,
# que dentro do container aponta para "localhost" em chamadas internas
# (health check, curl local) e quebraria a mídia no navegador do cliente.
# Só tem efeito em produção (config/environments/production.rb); se não
# setada, cai no fallback hardcoded pro host padrão do Easypanel.
APP_HOST=

# Active Record encryption (ChannelCredential#credentials) — gerar com `bin/rails db:encryption:init`
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# E-mail transacional (convite de usuário — UserMailer#invitation_email).
# Vars genéricas de SMTP, não específicas de provider — hoje configurado
# com Resend: address=smtp.resend.com, port=587, username=resend (literal,
# não é seu e-mail), password=API key do Resend (gerada em
# resend.com/api-keys). domain é o seu domínio verificado no Resend (usado
# no HELO/EHLO do SMTP, não precisa ser igual ao domínio do FRONTEND_URL).
# Sem essas vars, UserMailer detecta e loga um aviso em vez de tentar
# enviar — não trava o cadastro direto, que não depende de e-mail.
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_DOMAIN=
SMTP_USERNAME=
SMTP_PASSWORD=

# Remetente dos e-mails transacionais — precisa ser um endereço no domínio
# verificado no Resend (Settings > Domains), senão o envio é rejeitado
# mesmo com SMTP_* corretos. Sem essa var, cai no placeholder
# "no-reply@pricecom.com" (não é um domínio verificado — troque antes de
# usar em produção).
MAIL_FROM_ADDRESS=

# Anthropic API (Testimonials::AnthropicVisionClient — gera quote_text a partir
# de foto/frame de vídeo de um depoimento). Chave de app (não é credencial por
# tenant, ao contrário de ChannelCredential) — sem isso, GenerateQuoteTextJob
# falha e o depoimento fica sem quote_text sugerido (curador preenche à mão).
ANTHROPIC_API_KEY=

# WhatsApp operacional via WAHA. Em produção, WAHA_URL deve preferir a URL
# interna do serviço no Easypanel (ex: http://waha:3000). WAHA_ALERT_TO aceita
# um ou mais números internacionais sem "+", separados por vírgula; também
# aceita chatId completo (@c.us/@g.us). A sessão padrão criada no WAHA é
# "default". O notifier roda no Sidekiq e deduplica cada evento no Redis.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_ALERT_TO=

# ─── Produção (Easypanel) ────────────────────────────────────────────────
# Fornecidas pelos serviços gerenciados de Postgres/Redis do Easypanel.
DATABASE_URL=
REDIS_URL=

# config/master.key está no .dockerignore e portanto NÃO vai para a imagem —
# forneça RAILS_MASTER_KEY (conteúdo de config/master.key) como env var no
# Easypanel para decriptar config/credentials.yml.enc. Alternativa: setar
# SECRET_KEY_BASE diretamente (tem precedência e evita depender do master key).
RAILS_MASTER_KEY=

RAILS_LOG_TO_STDOUT=true
